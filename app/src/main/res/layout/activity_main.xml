<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F5FB">
    <ScrollView android:id="@+id/homeScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="390dp" android:background="@drawable/hero_gradient">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp">
                    <ImageView android:layout_width="120dp" android:layout_height="110dp" android:background="@drawable/brand_tile" android:padding="10dp" android:contentDescription="HAMediaConnect phone, speaker, and sound waves icon" android:scaleType="fitCenter" android:src="@drawable/hamediaconnect_brand" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="HAMediaConnect" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:text="Play audio from Home Assistant\non this Android device" android:textColor="#F3EFFF" android:textSize="17sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:orientation="horizontal" android:padding="14dp">
                    <Button android:id="@+id/settingsButton" android:layout_width="64dp" android:layout_height="56dp" android:gravity="center" android:text="⚙" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="27sp" android:backgroundTint="#5540A0" android:contentDescription="Open connection settings" />
                    <Button android:id="@+id/helpButton" android:layout_width="64dp" android:layout_height="56dp" android:gravity="center" android:text="?" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="27sp" android:backgroundTint="#5540A0" android:contentDescription="Open help and getting started" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_surface" android:orientation="vertical" android:padding="22dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="●  Home Assistant connection" android:textColor="#291C52" android:textStyle="bold" android:textSize="19sp" />
                    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Disconnected" android:textColor="#51436D" android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/card_surface" android:orientation="vertical" android:padding="22dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="♫  Playback" android:textColor="#291C52" android:textStyle="bold" android:textSize="21sp" />
                    <TextView android:id="@+id/playbackStatus" android:textIsSelectable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ready — Waiting for audio from Home Assistant" android:textColor="#51436D" android:textSize="17sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/gettingStartedCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/card_surface" android:orientation="vertical" android:padding="22dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ⓘ  Getting started" android:textColor="#291C52" android:textStyle="bold" android:textSize="20sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Use Home Assistant to play music or send a text-to-speech announcement to this device." android:textColor="#51436D" android:textSize="16sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="View setup guide  →" android:textColor="#5123A6" android:textStyle="bold" android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/settingsScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
            <TextView android:id="@+id/settingsBack" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:paddingBottom="24dp" android:text="‹   Settings" android:textColor="#21153E" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connection" android:textColor="#5123A6" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Connection method" android:textColor="#291C52" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/settingsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Disconnected" android:textColor="#291C52" android:textStyle="bold" android:textSize="18sp" />
            <RadioGroup android:id="@+id/authMethodGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/card_surface" android:padding="12dp">
                <RadioButton android:id="@+id/oauthChoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OAuth (recommended for HTTPS)" android:checked="true" android:textColor="#291C52" />
                <RadioButton android:id="@+id/tokenChoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Long-lived access token (local HTTP supported)" android:textColor="#291C52" />
            </RadioGroup>
            <LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_surface" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Home Assistant URL" android:textColor="#291C52" />
                <EditText android:id="@+id/urlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="https://homeassistant.example.com" android:inputType="textUri" android:singleLine="true" android:textColor="#291C52" android:textColorHint="#655A7A" android:backgroundTint="#5540A0" />
                <EditText android:id="@+id/tokenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Long-lived access token" android:inputType="textPassword" android:singleLine="true" android:visibility="gone" android:textColor="#291C52" android:textColorHint="#655A7A" android:backgroundTint="#5540A0" />
                <EditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Device name" android:inputType="textCapWords" android:singleLine="true" android:textColor="#291C52" android:textColorHint="#655A7A" android:backgroundTint="#5540A0" />
                <CheckBox android:id="@+id/allowHttpCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Allow insecure HTTP connections (not recommended)" android:textColor="#291C52" android:buttonTint="#5540A0" />
                <CheckBox android:id="@+id/startOnBootCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start connection after reboot" android:textColor="#291C52" android:buttonTint="#5540A0" />
                <Button android:id="@+id/oauthButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sign in with Home Assistant" />
                <Button android:id="@+id/saveStartButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save &amp; connect" />
                <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Disconnect" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Advanced" android:textColor="#5123A6" android:textSize="18sp" android:textStyle="bold" />
            <Button android:id="@+id/forgetCredentialsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Forget Home Assistant credentials" />
            <Button android:id="@+id/resetIdentityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reset device identity" />
            <TextView android:id="@+id/deviceIdText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#51436D" android:textIsSelectable="true" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/helpScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:paddingTop="64dp">
            <TextView android:id="@+id/helpBack" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:paddingBottom="8dp" android:text="‹   Help &amp; Getting Started" android:textColor="#21153E" android:textSize="24sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_surface" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                <ImageView android:layout_width="76dp" android:layout_height="51dp" android:scaleType="fitCenter" android:src="@drawable/hamediaconnect_brand" android:contentDescription="HAMediaConnect phone, speaker, and sound waves icon" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="HAMediaConnect\nHome Assistant audio for Android" android:textColor="#291C52" android:textSize="17sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Getting Started" android:textColor="#5123A6" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="❶  Connect to Home Assistant\n\nOpen Settings, enter your Home Assistant URL, and choose OAuth or a long-lived token." android:textColor="#291C52" android:textSize="17sp" />
            <TextView android:id="@+id/authHelpLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="12dp" android:clickable="true" android:focusable="true" android:text="Why OAuth or a token?  (?)" android:textColor="#5123A6" android:textStyle="bold" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="❷  Use it from Home Assistant\n\nFirst install the companion Home Assistant integration. Then select the HAMediaConnect media player entity to play music, change volume, mute, or send announcements." android:textColor="#291C52" android:textSize="17sp" />
            <TextView android:id="@+id/integrationInstallLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="12dp" android:clickable="true" android:focusable="true" android:text="Installation instructions on GitHub  ↗" android:textColor="#5123A6" android:textStyle="bold" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="❸  Enjoy\n\nAudio plays on this device, and interrupted music resumes after announcements. Announcements respect Do Not Disturb." android:textColor="#291C52" android:textSize="17sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>